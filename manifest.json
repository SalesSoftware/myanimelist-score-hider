{
  "manifest_version": 3,
  "author": "SalesSoftware",
  "name": "Myanimelist Score Hider",
  "version": "1.0.1",
  "description": "Hides scores on myanimelist",
  "permissions":[
    "storage"
  ],
  "action": {
    "default_title": "Myanimelist Score Hider",
    "default_area": "navbar",
    "default_icon":{
      "16": "icons/icon_16.png",
      "32": "icons/icon_32.png",
      "64": "icons/icon_64.png"
    },
    "default_popup": "popup-menu.html"
  },
  "icons": {
    "16": "icons/icon_16.png",
    "48": "icons/icon_48.png",
    "128": "icons/icon_128.png"
  },
  "content_scripts": [
        {
            "matches": ["https://myanimelist.net/*"],
            "js": ["js/system-config.js", "js/preload-hide.js"],
            "css": ["css/preload-hide.css"],
            "run_at": "document_start"
        },
        {
            "matches": ["https://myanimelist.net/*"],
            "js": ["js/storageSync.class.js", "js/scorehider.class.js"],
            "run_at": "document_end"
        }
    ],
  "minimum_chrome_version": "148",
  "browser_specific_settings": {
    "gecko": {
        "id": "{9ec0d0a2-bd78-4b5b-85f1-121fe2becce3}",
        "data_collection_permissions": {
          "required": [ "none" ]
        }
    }
  } 
}
